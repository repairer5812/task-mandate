{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "paths": { "vitest": ["./types/vitest-shim.d.ts"] }
  },
  "include": ["packages", "apps", "tests", "scripts", "types", "bench", "lab", "vitest.config.ts"],
  "exclude": ["apps/demo-worker", "**/dist"]
}
